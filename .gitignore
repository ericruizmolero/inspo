# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ShipStudio metadata
.shipstudio/

# Design references (local only)
/refs/

# Server-side hero screenshots (dev cache)
/public/shots/

# Working handoff files
HANDOFF-*.md
.data

# DESIGN.md cache (dev)
/public/design-md/
public/design-why/
/public/comments/
/public/media/
/public/posts/
prod.env

# Chrome Web Store packages (node extension/build.mjs)
extension/dist/

# Session scratch (dev logs, probes)
/scratchpad/

# Satoshi (ITF Free Font License): downloaded by scripts/fetch-fonts.mjs, never committed, because the
# licence forbids sharing the files through a public repository
/app/fonts/satoshi/
/extension/chrome/fonts/Satoshi-*.woff2

# Söhne test fonts (Klim Test Font Licence: internal evaluation only, never shipped, never shared)
/app/fonts/soehne-test/
