# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ShipStudio metadata
.shipstudio/

# Design references (local only)
/refs/

# Working handoff files
HANDOFF-*.md
.data

/public/posts/
# What the app stores on disk when R2 is not set (local only): captures, DESIGN.md files and their reasons
/public/shots/
/public/design-md/
/public/design-why/
prod.env

# Chrome Web Store packages (node extension/build.mjs)
extension/dist/

# Session scratch (dev logs, probes)
/scratchpad/

# Satoshi (ITF Free Font License): downloaded by scripts/fetch-fonts.mjs, never committed, because the
# licence forbids sharing the files through a public repository
/app/fonts/satoshi/
/extension/chrome/fonts/Satoshi-*.woff2
/extension/dist/

# Söhne test fonts (Klim Test Font Licence: internal evaluation only, never shipped, never shared)
/app/fonts/soehne-test/

# A connector skill's scripts install their own dependencies next to them (skills/<id>/scripts); never in the tree
/skills/*/scripts/node_modules/
