{
  "manifest_version": 3,
  "name": "criterio.design",
  "description": "Guarda la web que estás viendo en tu librería de criterio.design con un clic.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Guardar en criterio.design",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://criterio.design/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://criterio.design/extension/conectar*",
        "http://localhost/extension/conectar*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}