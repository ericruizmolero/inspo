{
  "manifest_version": 3,
  "name": "criterio.design",
  "description": "__MSG_extDescription__",
  "version": "0.7.2",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "bookmarks",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "https://criterio.design/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://x.com/*",
    "https://*.pinterest.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://criterio.design/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
