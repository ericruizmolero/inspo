---
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { copy, type Locale } from "../i18n";

const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
---
<Base lang={t.lang} page="home" title={t.title} description={t.body}>
  <Header locale={locale} page="home" />

  <main class="hero">
    <h1>{t.headline}</h1>
    <p>{t.body}</p>
  </main>

  <Footer locale={locale} page="home" />
</Base>

<style>
  .hero { max-width: 1080px; margin: 0 auto; padding: 96px 24px 120px; }
  .hero h1 {
    max-width: 14em;
    font-size: 40px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .hero p {
    max-width: 34em;
    margin-top: 20px;
    color: var(--text-2);
    font-size: 17px;
    font-weight: 400;
    line-height: 1.55;
  }
  @media (max-width: 640px) {
    .hero { padding-top: 56px; }
    .hero h1 { font-size: 32px; }
  }
</style>
