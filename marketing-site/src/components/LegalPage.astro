---
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { LEGAL, LEGAL_UPDATED, legal, type LegalDocKey } from "../legal";
import type { Locale } from "../i18n";

interface Props { locale: Locale; doc: LegalDocKey }
const { locale, doc } = Astro.props;
const t = legal[locale];
const page = t.docs[doc];
const updated = new Intl.DateTimeFormat(locale, { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(new Date(LEGAL_UPDATED));
---
<Base lang={locale} page={doc} title={`${page.title} · criterio.design`} description={page.lead}>
  <Header locale={locale} page={doc} />

  <main class="doc">
    <header class="doc__head">
      <h1>{page.title}</h1>
      <p class="doc__lead">{page.lead}</p>
      <p class="doc__date">{t.updated(updated)}</p>
    </header>
    {page.sections(LEGAL).map((s) => (
      <section>
        <h2>{s.heading}</h2>
        {s.body.map((block) => typeof block === "string"
          ? <p>{block}</p>
          : <ul>{block.map((line) => <li>{line}</li>)}</ul>)}
      </section>
    ))}
  </main>

  <Footer locale={locale} page={doc} />
</Base>

<style>
  .doc { display: flex; flex-direction: column; gap: 28px; max-width: 688px; margin: 0 auto; padding: 56px 24px 72px; }
  .doc__head { display: flex; flex-direction: column; gap: 12px; padding-bottom: 8px; }
  h1 { font-size: 40px; font-weight: 700; line-height: 1.05; letter-spacing: -0.025em; text-wrap: balance; }
  .doc__lead { max-width: 34em; color: var(--text-2); font-size: 17px; font-weight: 400; line-height: 1.55; }
  .doc__date { color: var(--text-2); font-size: 13px; }
  section { display: flex; flex-direction: column; gap: 8px; }
  h2 { font-size: 17px; font-weight: 700; line-height: 1.3; }
  p, li { color: var(--text-2); font-size: 16px; font-weight: 400; line-height: 1.6; text-wrap: pretty; }
  ul { display: flex; flex-direction: column; gap: 8px; margin: 0; padding-left: 20px; list-style: disc; }
  li::marker { color: var(--text-2); }
  @media (max-width: 640px) {
    .doc { padding-top: 32px; }
    h1 { font-size: 32px; }
  }
</style>
