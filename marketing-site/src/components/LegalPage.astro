---
import Base from "../layouts/Base.astro";
import SiteHeader from "./SiteHeader.astro";
import Footer from "./Footer.astro";
import { LEGAL, LEGAL_UPDATED, legal, type LegalDocKey } from "../legal";
import type { Locale } from "../i18n";

interface Props { locale: Locale; doc: LegalDocKey }
const { locale, doc } = Astro.props;
const t = legal[locale];
const page = t.docs[doc];
const updated = new Intl.DateTimeFormat(locale, { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(new Date(LEGAL_UPDATED));
---
<Base lang={locale} page={doc} title={`${page.title} | criterio.design`} description={page.lead}>
  <SiteHeader locale={locale} page={doc} />

  <main class="doc">
    <header class="doc__head">
      <h1>{page.title}</h1>
      <p class="doc__lead">{page.lead}</p>
      <p class="doc__date">{t.updated(updated)}</p>
    </header>
    {page.sections(LEGAL).map((s) => (
      <section>
        <h2>{s.heading}</h2>
        {s.body.map((block) => typeof block === "string"
          ? <p>{block}</p>
          : <ul>{block.map((line) => <li>{line}</li>)}</ul>)}
      </section>
    ))}
  </main>

  <Footer locale={locale} page={doc} />
</Base>

<style>
  .doc { display: flex; flex-direction: column; gap: 44px; max-width: 728px; margin: 0 auto; padding: 48px 24px 96px; }
  .doc__head { display: flex; flex-direction: column; gap: 18px; padding-bottom: 20px; }
  h1 { font: var(--h-w) clamp(40px, 5.4vw, 66px)/1.05 var(--font-display); letter-spacing: var(--h-ls); text-wrap: balance; }
  .doc__lead { max-width: 30em; color: var(--ink); font-size: 20px; line-height: 1.45; text-wrap: pretty; }
  .doc__date { color: var(--text-2); font-size: 15px; }
  section { display: flex; flex-direction: column; gap: 12px; }
  h2 { margin-bottom: 4px; font: var(--h-w) clamp(25px, 2.6vw, 32px)/1.12 var(--font-display); letter-spacing: var(--h-ls); text-wrap: balance; }
  section p, li { color: #3a3832; font-size: 17px; line-height: 1.6; text-wrap: pretty; }
  ul { display: flex; flex-direction: column; gap: 8px; margin: 0; padding-left: 20px; list-style: disc; }
  li::marker { color: var(--text-2); }
  @media (max-width: 640px) { .doc { padding-top: 24px; } .doc__lead { font-size: 18px; } }
</style>
