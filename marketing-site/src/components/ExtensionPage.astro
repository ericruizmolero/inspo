---
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import PageHead from "./PageHead.astro";
import { APP_URL, PAGES, copy, type Locale } from "../i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale].extension;
// The app builds the zip from extension/chrome and serves it without a session (proxy.ts): one zip for both ways in
const ZIP = `${APP_URL}/extension/download`;
// Web pages cannot link to chrome:// addresses, so it is shown to be copied. Arc, Edge and Brave take it too
const EXTENSIONS_URL = "chrome://extensions";
---
<Base lang={locale} page="extension" title={`${t.title} · criterio.design`} description={t.lead}>
  <Header locale={locale} page="extension" />

  <main class="ext">
    <PageHead headline={t.headline} lead={t.lead} />

    <section class="steps">
      <h2 class="sr-only">{t.steps}</h2>
      <ol>
        <li>
          <h3>{t.download.title}</h3>
          <p>{t.download.body}</p>
          <a class="btn" href={ZIP} download>{t.download.action}</a>
        </li>
        <li>
          <h3>{t.load.title}</h3>
          <ol class="sub">
            <li>{t.load.unzip}</li>
            <li>
              {t.load.open}
              <span class="address">
                <code>{EXTENSIONS_URL}</code>
                <button type="button" data-copy={EXTENSIONS_URL} aria-label={t.load.copyAddress} hidden>{t.load.copy}</button>
              </span>
            </li>
            <li>{t.load.devMode}</li>
            <li>{t.load.unpacked}</li>
          </ol>
        </li>
        <li>
          <h3>{t.connect.title}</h3>
          <p>{t.connect.body}</p>
        </li>
        <li>
          <h3>{t.save.title}</h3>
          <p>{t.save.body}</p>
        </li>
      </ol>
    </section>

    <p class="privacy"><a href={PAGES.extensionPrivacy.path[locale]}>{t.privacy}</a></p>
  </main>

  <Footer locale={locale} page="extension" />
</Base>

<script is:inline define:vars={{ copied: t.load.copied }}>
  for (const button of document.querySelectorAll("[data-copy]")) {
    const label = button.textContent;
    let timer;
    button.hidden = false;
    button.addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(button.dataset.copy); } catch { return; }
      button.textContent = copied;
      clearTimeout(timer);
      timer = setTimeout(() => { button.textContent = label; }, 1600);
    });
  }
</script>

<style>
  .ext { display: flex; flex-direction: column; gap: 40px; max-width: 720px; margin: 0 auto; padding: 56px 24px 80px; }

  /* Numbered steps: the number in a ring on the left, the step's title and text beside it */
  .steps > ol { display: flex; flex-direction: column; gap: 28px; margin: 0; padding: 0; list-style: none; counter-reset: step; }
  .steps > ol > li { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 8px; padding-left: 48px; counter-increment: step; }
  .steps > ol > li::before {
    content: counter(step); position: absolute; left: 0; top: -2px; display: grid; place-items: center; width: 30px; height: 30px;
    border: 1.5px solid var(--ink); border-radius: 999px; font-size: 14px; font-weight: 700; font-variant-numeric: tabular-nums;
  }
  h3 { margin: 0; font-size: 18px; font-weight: 700; letter-spacing: -0.01em; }
  .steps p, .sub { max-width: 36em; color: var(--text-2); font-size: 15px; font-weight: 400; line-height: 1.55; text-wrap: pretty; }
  .sub { display: flex; flex-direction: column; gap: 8px; margin: 0; padding-left: 20px; }
  .sub li::marker { color: var(--ink); font-weight: 600; }

  .address { display: flex; align-items: center; gap: 8px; width: fit-content; max-width: 100%; height: 36px; margin-top: 6px; padding: 0 4px 0 10px; border: 1px solid var(--border); border-radius: 10px; background: var(--paper-light); }
  .address code { color: var(--ink); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; }
  .address button { height: 28px; padding: 0 10px; border: 0; border-radius: 6px; background: var(--paper); color: var(--ink); font: inherit; font-size: 12px; font-weight: 600; cursor: pointer; }
  .address button[hidden] { display: none; }
  .address button:hover { background: var(--paper-pressed); }
  .address button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

  /* Button primary, size m (docs/design-system/botones.md), the same as the header's */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 44px; margin-top: 4px; padding: 0 18px;
    border: 1.5px solid var(--ink); border-radius: 10px; background: var(--ember); color: var(--ink);
    font-weight: 600; text-decoration: none; white-space: nowrap; box-shadow: var(--bevel);
    transition: background-color 150ms ease, box-shadow 100ms ease, transform 100ms ease;
  }
  .btn:hover { background: var(--ember-glow); }
  .btn:active { box-shadow: var(--bevel-pressed); transform: translateY(1px); }
  .btn:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

  .privacy a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--border); text-underline-offset: 3px; }
  .privacy a:hover { text-decoration-color: currentColor; }
  .privacy a:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; border-radius: 2px; }

  @media (max-width: 640px) { .ext { padding-top: 32px; } }
</style>
