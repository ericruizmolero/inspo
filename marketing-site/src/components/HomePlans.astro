---
// The plans on the home (/, /es/), between the product's window and criterio.md. Same source as /pricing/ and the app
// (plans.ts), so the home cannot drift from either. Drawn in the home's own language (its tokens, the display serif,
// the ink-bordered cream of its email field and its key), which the generated page defines on :root. While signup is
// invite-only the key goes to the waitlist form; once it is open, signup-mode.ts turns it into "Start free"
import { PAGES, copy, type Locale } from "../i18n";
import { PLANS, PLAN_LINES, PLAN_TEXT, fmtPrice, isPaid } from "../plans";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const lines = PLAN_LINES[locale];
const text = PLAN_TEXT[locale];
---
<section class="pricing" id="pricing" aria-labelledby="pricing-h">
  <h2 id="pricing-h">{t.pricing.section.headline}</h2>
  <p class="pricing-sub">{t.pricing.section.sub}</p>
  <ul>
    {PLANS.map((p) => (
      <li>
        <h3>{text[p.key].name}</h3>
        <p class="plan-tag">{text[p.key].tagline}</p>
        <p class="plan-price"><b>{fmtPrice(p.price.month, locale)}</b> <span>{lines.perMonth}</span></p>
        <p class="plan-year">{isPaid(p) ? lines.orYearly(fmtPrice(p.price.year, locale)) : lines.forGood}</p>
        <ul class="plan-has">{text[p.key].features.map((f) => <li>{f}</li>)}</ul>
      </li>
    ))}
  </ul>
  <div class="pricing-foot">
    <a class="btn" href="#mail" data-open-href={t.login.href} data-open-label={t.pricing.start}>{t.waitlist.join}</a>
    <p>{lines.foot} <a href={PAGES.pricing.path[locale]}>{t.pricing.section.all}</a></p>
  </div>
</section>

<style>
  .pricing { max-width: 1180px; margin: clamp(104px, 18svh, 176px) 0 0; }
  h2 { margin: 0; font: var(--h-w) clamp(31px, 3.4vw, 48px)/1.05 var(--display); letter-spacing: var(--h-ls); text-wrap: balance; }
  .pricing-sub { max-width: 35em; margin: clamp(10px, 1.8svh, 16px) 0 0; color: var(--text-2); text-wrap: pretty; }

  /* Each card shares its rows with the others (subgrid), so prices and lists line up whatever the tagline's length */
  ul { margin: 0; padding: 0; list-style: none; }
  .pricing > ul { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-top: clamp(28px, 4.6svh, 44px); }
  .pricing > ul > li { display: grid; grid-row: span 5; grid-template-rows: subgrid; row-gap: 0; min-width: 0; padding: 24px 22px 26px; border: 1.5px solid var(--ink); border-radius: var(--r); background: var(--paper-l); }
  h3 { margin: 0; font: 400 clamp(26px, 2.2vw, 32px)/1.1 var(--display); letter-spacing: -.02em; }
  .plan-tag { margin: 6px 0 0; color: var(--text-2); font-size: 15px; line-height: 1.4; text-wrap: pretty; }
  .plan-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px; margin: 22px 0 0; }
  .plan-price b { font: 400 clamp(40px, 3.4vw, 48px)/1 var(--display); letter-spacing: var(--h-ls); font-variant-numeric: tabular-nums; }
  .plan-price span, .plan-year { color: var(--text-2); font-size: 15px; }
  .plan-year { margin: 6px 0 0; line-height: 1.4; text-wrap: pretty; }
  .plan-has { display: grid; align-content: start; gap: 9px; margin-top: 20px; padding-top: 18px; border-top: 1.5px dashed rgb(27 27 24 / .18); font-size: 15px; line-height: 1.4; }
  .plan-has li { position: relative; padding-left: 22px; text-wrap: pretty; }
  .plan-has li::before { content: ""; position: absolute; left: 2px; top: .42em; width: 9px; height: 5px; border-left: 1.5px solid var(--ink); border-bottom: 1.5px solid var(--ink); rotate: -45deg; }

  .pricing-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; margin-top: 26px; }
  .pricing-foot .btn { text-decoration: none; }
  .pricing-foot p { flex: 1 1 360px; max-width: 64ch; margin: 0; color: var(--text-2); font-size: 14px; line-height: 1.5; text-wrap: pretty; }
  .pricing-foot p a { color: var(--ink); font-weight: 600; text-underline-offset: 3px; }

  @media (max-width: 1080px) { .pricing > ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .pricing > ul { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .pricing > ul > li { padding: 20px 18px 22px; }
  }
</style>
