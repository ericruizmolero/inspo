---
// The top of a page under the header: its h1 and what the page holds
interface Props { headline: string; lead: string }
const { headline, lead } = Astro.props;
---
<header class="head">
  <h1>{headline}</h1>
  <p>{lead}</p>
</header>

<style>
  .head { display: flex; flex-direction: column; gap: 16px; }
  h1 { font: var(--h-w) clamp(40px, 5.4vw, 66px)/1.05 var(--font-display); letter-spacing: var(--h-ls); text-wrap: balance; }
  p { max-width: 34em; color: var(--text-2); font-size: 18px; line-height: 1.45; text-wrap: pretty; }
</style>
