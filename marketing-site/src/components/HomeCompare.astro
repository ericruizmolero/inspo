---
// The same brief with and without Criterio, one page over the other: drag anywhere on it, or move the slider with the keyboard
import type { Locale } from "../i18n";
import { homeCopy } from "../home-copy";

interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section id="encargo">
  {[locale].map((locale) => {
    const t = homeCopy[locale].compare;
    return (
      <div>
        <h2><span>{t.headline[0]}</span> <span>{t.headline[1]}</span></h2>
        <p class="hc-sub">{t.brief}</p>
        <div class="hc-compare">
          <img src={`/assets/vault/ba/con-${locale}.webp`} srcset={`/assets/vault/ba/con-${locale}-1040.webp 1040w, /assets/vault/ba/con-${locale}.webp 2080w`} sizes="(max-width: 1100px) 100vw, 1040px" alt={t.with.alt} width="2080" height="1300" loading="lazy" decoding="async" draggable="false" />
          <img class="hc-over" src={`/assets/vault/ba/sin-${locale}.webp`} srcset={`/assets/vault/ba/sin-${locale}-1040.webp 1040w, /assets/vault/ba/sin-${locale}.webp 2080w`} sizes="(max-width: 1100px) 100vw, 1040px" alt={t.without.alt} width="2080" height="1300" loading="lazy" decoding="async" draggable="false" />
          <input type="range" min="0" max="100" value="50" step="1" aria-label={t.slider} />
          <i class="hc-bar" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 7l-5 5 5 5M15 7l5 5-5 5" /></svg></i>
        </div>
        <div class="hc-names"><p>{t.without.name}</p><p>{t.with.name}</p></div>
      </div>
    );
  })}
</section>

<script>
  document.querySelectorAll<HTMLElement>("#encargo .hc-compare").forEach((box) => {
    const range = box.querySelector("input")!, over = box.querySelector<HTMLElement>(".hc-over")!, bar = box.querySelector<HTMLElement>(".hc-bar")!;
    const put = (v: number) => { range.value = String(v); over.style.clipPath = `inset(0 ${100 - v}% 0 0)`; bar.style.transform = `translateX(${v - 100}%)`; };
    const at = (e: PointerEvent) => { const r = box.getBoundingClientRect(); put(Math.min(100, Math.max(0, ((e.clientX - r.left) / r.width) * 100))); };
    range.addEventListener("input", () => put(Number(range.value)));
    box.addEventListener("pointerdown", (e) => { if (e.button) return; box.setPointerCapture(e.pointerId); at(e); });
    box.addEventListener("pointermove", (e) => { if (box.hasPointerCapture(e.pointerId)) at(e); });
  });
</script>

<style>
  section { margin-top: clamp(104px, 18svh, 176px); scroll-margin-top: 72px; }
  h2 { margin: 0; font: var(--h-w) clamp(31px, 4.4vw, 48px)/1.05 var(--display); letter-spacing: var(--h-ls); text-wrap: balance; }
  h2 span { display: block; }
  h2 span + span { color: var(--h-2); }
  .hc-sub { margin: clamp(10px, 1.8svh, 16px) 0 0; color: var(--text-2); text-wrap: pretty; }
  .hc-compare { position: relative; aspect-ratio: 16 / 10; margin-top: clamp(28px, 4.6svh, 44px); overflow: hidden; border: 1.5px solid var(--ink); border-radius: var(--r); background: var(--paper-l); cursor: ew-resize; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; object-position: 0 0; pointer-events: none; }
  .hc-over { clip-path: inset(0 50% 0 0); }
  /* the slider is for the keyboard and for screen readers: the pointer drags the whole picture */
  input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; pointer-events: none; }
  /* as wide as the picture: its right edge is the seam, so moving it is a transform */
  .hc-bar { position: absolute; inset: 0; border-right: 2px solid var(--ink); transform: translateX(-50%); pointer-events: none; }
  .hc-bar svg { position: absolute; top: 50%; left: calc(100% + 1px); box-sizing: border-box; width: 52px; height: 44px; padding: 9px 13px 11px; translate: -50% -50%; border: 1.5px solid #1B1B18; border-radius: var(--rb); background: #E8892B; box-shadow: var(--bevel), 0 4px 0 #1B1B18; fill: none; stroke: #1B1B18; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; transition: background-color .12s, box-shadow .09s steps(2); }
  @media (hover: hover) and (pointer: fine) { .hc-compare:hover .hc-bar svg { background: #F6A848; } }
  .hc-compare:active .hc-bar svg { box-shadow: var(--bevel-in), 0 1px 0 #1B1B18; }
  .hc-compare:has(input:focus-visible) { outline: 2px solid var(--ink); outline-offset: 4px; }
  .hc-names { display: flex; justify-content: space-between; gap: 24px; margin-top: 12px; font-size: 16px; line-height: 1.4; }
  .hc-names p { margin: 0; text-wrap: balance; }
  .hc-names p + p { text-align: right; }
  @media (max-width: 760px) { .hc-compare { aspect-ratio: 1; } }
</style>
