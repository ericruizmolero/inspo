.x-draw { display: grid; place-items: center; background: #171A1F; } .x-draw svg { width: 150px; height: 130px; overflow: visible; } .x-draw path { fill-opacity: 0; stroke: #E9ECEF; stroke-width: 1.4; stroke-linejoin: round; }
