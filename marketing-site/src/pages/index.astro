.bld .zlk u { padding: 0; color: #0000EE; text-decoration: underline; background: none; }
.bld .zlk .zsl { text-decoration: none; }
.bld .zn { top: 36px; left: 10px; font-size: 26px; font-weight: 700; line-height: 1; white-space: nowrap; }
.bld .zn i { font-style: normal; transition: color .9s; }
.bld .zh { top: 70px; left: 10px; display: block; max-width: 60%; margin: 0; font-size: 18px; font-weight: 400; line-height: 1.2; }
.bld .zld { top: 100px; left: 10px; right: auto; max-width: 60%; margin: 0; font-size: 14px; line-height: 1.3; }
.zhr { position: absolute; left: 0; right: 0; height: 1px; background: rgb(20 19 17 / .16); opacity: 0; transition: opacity .6s, top .9s var(--out); }
.zsh { position: absolute; left: 0; bottom: 0; display: flex; align-items: flex-end; gap: .45cqw; height: 47cqh; padding-left: 0; transform: translateX(105%); transition: transform 1.4s cubic-bezier(.65, 0, .2, 1); }
.zsh img { display: block; height: var(--h); width: auto; }
.bld .zal { top: 54px; }
/* 1 · retícula: cada cosa a su sitio */
.bld.zs1 .zlk { left: var(--pm); right: var(--pm); top: 2.6cqh; display: grid; grid-template-columns: repeat(5, 1fr); justify-items: center; }
.bld.zs1 .zlk u:first-child { justify-self: start; } .bld.zs1 .zlk u:last-child { justify-self: end; }
.bld.zs1 .zn { left: 1.2cqw; top: 9cqh; }
.bld.zs1 .zh { left: 1.2cqw; top: 36cqh; max-width: 38%; }
.bld.zs1 .zld { left: auto; right: 1.2cqw; top: 36cqh; max-width: 30%; }
.bld.zs1 .zh1 { top: 34.5cqh; } .bld.zs1 .zh2 { top: 46cqh; }
/* 2 · la marca a todo lo ancho (Vonder) */
.bld.zs2 .zn { top: 8cqh; font: 400 18.1cqw/.86 "Geist Serif", "Newsreader", serif; letter-spacing: -.05em; }
.bld.zs2 .zh { font: 400 1.8cqw/1.18 "Geist Serif", "Newsreader", serif; top: 37cqh; }
.bld.zs2 .zld { font: .95cqw/1.4 "Geist Serif", "Newsreader", serif; top: 37cqh; }
.bld.zs2 .zlk { font: 1cqw/1 "Geist Serif", "Newsreader", serif; text-transform: uppercase; letter-spacing: .04em; }
/* 3 · papel claro, tinta negra (Wabi) */
.bld.zs3 { background: #F7F4EE; color: #141311; }
.bld.zs3 .zn, .bld.zs3 .zh { color: #141311; }
.bld.zs3 .zn i { color: #E2492B; }
.bld.zs3 .zlk u { color: #141311; text-decoration: none; }
.bld.zs3 .zhr { opacity: 1; }
.bld.zs3 .zld { color: rgb(20 19 17 / .78); }
.bld.zs3 .zal span { border-top-color: rgb(20 19 17 / .12); color: rgb(20 19 17 / .3); }
/* 4 · menú de vidrio (Vault) */
.bld.zs4 .zlk { left: 1.2cqw; right: 1.2cqw; top: 1cqh; height: 5.4cqh; align-items: center; padding: 0 1cqw; border-radius: 999px; background: rgb(247 244 238 / .55); box-shadow: inset 0 0 0 1px rgb(20 19 17 / .16), 0 10px 28px rgb(20 19 17 / .12); }
.bld.zs4 .zlk .zsl { display: grid; place-items: center; width: 4cqh; height: 4cqh; border-radius: 50%; background: #E2492B; color: #F7F4EE; box-shadow: inset 0 0 0 2px #F7F4EE, 0 0 0 1px #E2492B; }
.bld.zs4 .zal { opacity: 0; }
/* 5 · láminas en fila (Casa Momo) */
.bld.zs5 .zsh { transform: none; }
.bld[data-s="2"] .zn { outline: 1.5px solid #E8892B; outline-offset: 4px; }
.bld[data-s="3"] :is(.zn, .zh) { outline: 0; }
.bld[data-s="5"] .zsh { outline: 1.5px solid #E8892B; outline-offset: -4px; }
.bld .zrf { z-index: 4; }
.narrow .bld.zs1 .zld { display: none; } .narrow .bld.zs1 .zh { max-width: 80%; } .narrow .bld.zs1 .zlk u:nth-child(2), .narrow .bld.zs1 .zlk u:nth-child(4) { visibility: hidden; }

/* ── Plomo, cuarta vuelta (20/11): el logo impreso a dos tintas también en el borrador, a partir del papel claro ── */
.bld .zn { isolation: isolate; }
.bld .zn::before { content: attr(data-text); position: absolute; z-index: -1; left: 0; top: 0; color: transparent; background: repeating-linear-gradient(-50deg, #E2492B 0 .016em, transparent .016em .042em); -webkit-background-clip: text; background-clip: text; opacity: 0; transform: translate(0, 0); transition: transform 1.1s var(--out) .2s, opacity .3s; pointer-events: none; }
.bld.zs3 .zn::before { opacity: 1; transform: translate(.045em, .036em); }
</style>
</head>
