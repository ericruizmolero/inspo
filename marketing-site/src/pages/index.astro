.slop, .sub, .consent, .consent input { transition: color var(--ti), border-color var(--ti), outline-color .3s var(--out), outline-offset .3s var(--out); } .slop g path { transition: fill var(--ti); } html.dark .slop { color: #F1EEE5; } html.dark .slop g path { fill: #F1EEE5; } html.dark .sub, html.dark .consent { color: #B8B1A3; } html.dark .consent input { border-color: #F1EEE5; } html.dark .consent a:hover { color: #F1EEE5; }
html.dark .mf-bar { --bar-c: #F1EEE5; --bar-i: #F1EEE5; --bar-l: #2B2A26; } html.dark .mfz, .mf.full .mfz { border-color: transparent; }
html:not(.dark) .mf-bar { --bar-c: #1B1B18; --bar-i: #1B1B18; --bar-l: #D3CFC5; } .z1 { inset: -10px calc(var(--g) * .82) 0; } .z2 { inset: -22px calc(var(--g) * .62) 0; opacity: .55; } .z3 { inset: -36px calc(var(--g) * .4) 0; opacity: .25; } .mf-in { position: relative; max-width: min(880px, calc(100vw - 2 * var(--gmax) - 56px)); margin-inline: auto; } /* centrado en la pantalla, como el resto (Eric, 23-11) */ .mf { --gmax: 19vw; } @media (max-width: 1100px) { .mf { --gmax: 8vw; } } @media (max-width: 760px) { .mf { --gmax: 5.5vw; } }
