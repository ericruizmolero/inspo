.fp > * { width: var(--fw); }
/* (prueba 23-11) con el vídeo abierto, Tino se asoma por encima del marco, a la izquierda (Cerrar va a la derecha): el mismo lienzo de la esquina, que vuelve a ella al cerrar */ .fp-peek { position: absolute; z-index: 0; left: 5%; top: 0; width: 132px; height: 132px; translate: 0 -80%; } .fp:fullscreen .fp-peek { display: none; } @media (max-width: 760px) { .fp-peek { width: 96px; height: 96px; } }
.fp-screen { position: relative; z-index: 1; aspect-ratio: 16 / 9; overflow: hidden; border: 1.5px solid var(--ink); border-radius: var(--r); background: #E5E6DF; box-shadow: 0 6px 0 var(--ink); cursor: pointer; }
dialog .fp-screen video { display: block; width: 100%; height: 100%; object-fit: cover; background: #E5E6DF; }
.fp-big { position: absolute; left: 50%; top: 50%; display: grid; place-items: center; width: 76px; height: 76px; padding: 0 0 0 4px; translate: -50% -50%; border: 1.5px solid var(--ink); border-radius: 50%; background: var(--ember); color: var(--ink); box-shadow: var(--bevel), 0 4px 0 var(--ink); opacity: 0; scale: .88; pointer-events: none; cursor: pointer; transition: opacity .3s var(--out), scale .3s var(--out), background-color .3s var(--out); }
.fp:not(.live):not(.paused) .fp-screen { cursor: none; } .fp:focus { outline: none; } .fp-big svg { width: 28px; height: 28px; fill: currentColor; } .fp.paused .fp-big { opacity: 1; scale: 1; pointer-events: auto; } .fp-screen:hover .fp-big { background: var(--glow); }
.fp-bar { position: absolute; z-index: 2; left: 14px; right: 14px; bottom: 14px; box-sizing: border-box; display: flex; align-items: center; gap: 14px; padding: 6px 10px 6px 7px; border: 1.5px solid var(--ink); border-radius: var(--r); background: var(--paper-l); box-shadow: var(--bevel); cursor: default; opacity: 0; translate: 0 10px; pointer-events: none; transition: opacity .3s var(--out), translate .3s var(--out); }
.fp.live .fp-bar, .fp-bar:hover, .fp-screen:has(:focus-visible) .fp-bar, .fp.paused .fp-bar, .fp.poke .fp-bar { opacity: 1; translate: 0 0; pointer-events: auto; }
.fp-b { flex: none; display: grid; place-items: center; width: 40px; height: 40px; padding: 0; border: 1.5px solid transparent; border-radius: 50%; background: transparent; color: var(--ink); cursor: pointer; transition: background-color .3s var(--out); }
.fp-b:hover { background: rgb(27 27 24 / .07); } .fp-b svg { width: 18px; height: 18px; fill: currentColor; }
.fp-b:focus-visible, .fp-track:focus-visible, .fp-big:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
.fp-play { --lift: 3px; margin-bottom: var(--lift); border-color: var(--ink); background: var(--ember); box-shadow: var(--bevel), 0 var(--lift) 0 var(--ink); transition: transform .09s steps(2), box-shadow .09s steps(2), background-color .3s var(--out); }
.fp-play:hover { transform: translateY(2px); box-shadow: var(--bevel-in), 0 1px 0 var(--ink); background: var(--glow); } .fp-play:active { transform: translateY(3px); box-shadow: var(--bevel-in), 0 0 0 var(--ink); }
.fp-track { --pp: 0; position: relative; flex: 1; min-width: 0; height: 30px; cursor: pointer; touch-action: none; outline-offset: 2px; border-radius: 99px; }
.fp-track::before, .fp-fill { content: ""; position: absolute; left: 0; top: 50%; height: 12px; box-sizing: border-box; translate: 0 -50%; border: 1.5px solid var(--ink); border-radius: 99px; }
.fp-track::before { right: 0; background: var(--paper); box-shadow: var(--bevel-in); } .fp-fill { width: calc(20px + (100% - 20px) * var(--pp)); background: var(--ember); box-shadow: var(--bevel); }
