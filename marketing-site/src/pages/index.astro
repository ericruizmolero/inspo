/* el final ocurre fuera de Criterio: en la IA de cada uno */
.ai { position: absolute; z-index: 8; left: 190px; right: 44px; top: 46px; bottom: 46px; overflow: hidden; border-radius: 14px; background: #FAF9F5; color: #23221E; box-shadow: 0 0 0 1px rgb(255 255 255 / .1), 0 50px 110px rgb(0 0 0 / .7); opacity: 0; transform: translateX(70px) scale(.97); transition: opacity .25s, transform .95s var(--out); } .ai.on { opacity: 1; transform: none; } .narrow .ai { left: 18px; right: 18px; top: 160px; bottom: 26px; }
.aib { display: flex; align-items: center; gap: 7px; height: 40px; padding: 0 14px; border-bottom: 1px solid #E5E2D8; font-weight: 600; } .aib i { width: 11px; height: 11px; border-radius: 50%; background: #DAD6CA; } .aib span { margin-left: 8px; } .aib em { margin-left: auto; padding: 4px 8px; border-radius: 7px; background: #EEF0E2; color: #4F6B3A; font-size: 12px; font-style: normal; font-weight: 600; }
.chat { position: absolute; left: 0; top: 40px; bottom: 0; width: 380px; padding: 20px; border-right: 1px solid #E5E2D8; } .me { padding: 11px 13px; border-radius: 12px; background: #EEEBE1; font-size: 15px; line-height: 1.35; min-height: 62px; } .caret { display: inline-block; width: 2px; height: 1em; margin-left: 1px; vertical-align: -2px; background: #23221E; } .tl { margin-top: 18px; display: grid; gap: 10px; } .tl p { display: flex; gap: 8px; margin: 0; opacity: 0; transform: translateY(5px); color: #54524A; transition: opacity .2s, transform .5s var(--out); } .tl p.on { opacity: 1; transform: none; } .tl svg { color: #4F6B3A; margin-top: 1px; } .narrow .chat { position: static; width: auto; height: 250px; padding: 14px; border-right: 0; border-bottom: 1px solid #E5E2D8; } .narrow .me { min-height: 0; } .narrow .tl { margin-top: 10px; gap: 5px; }
.site { position: absolute; left: 380px; right: 0; top: 40px; bottom: 0; overflow: hidden; background: #F6F1E6; } .narrow .site { left: 0; top: 290px; } .bl { opacity: 0; transform: translateY(14px); transition: opacity .3s, transform .75s var(--out); } .bl.on { opacity: 1; transform: none; } .sn { display: flex; justify-content: space-between; padding: 24px 40px 0; font-weight: 600; } .site h5 { margin: 56px 40px 0; font: 400 86px/.96 var(--display); letter-spacing: -.05em; } .narrow .site h5 { margin-top: 26px; font-size: 62px; } .site .ss { margin: 16px 40px 0; color: var(--text-2); font-size: 18px; } .plans { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 42px 40px 0; } .narrow .plans { margin-top: 22px; } .plan { padding: 18px; border-radius: 12px; background: #20302A; color: #E8F0DF; } .plan + .plan { background: #E8DFCC; color: var(--ink); } .plan b { display: block; font: 400 34px/1.1 var(--display); }

.z { position: fixed; z-index: 50; left: 0; top: 0; border: 1.5px solid var(--ink); pointer-events: none; }
dialog { width: 100vw; max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 0; border: 0; background: #E7E5DF; opacity: 0; transition: opacity .12s; overflow: hidden; } dialog.show { opacity: 1; } dialog::backdrop { background: transparent; } #film { background: rgb(27 27 24 / .42); -webkit-backdrop-filter: blur(18px) saturate(1.1); backdrop-filter: blur(18px) saturate(1.1); transition: opacity .3s var(--out); } #film .fp { opacity: 0; transform: translateY(14px) scale(.97); transition: opacity .3s var(--out), transform .45s var(--out); } #film.show .fp { opacity: 1; transform: none; } #film .fp:fullscreen { transform: none; } dialog iframe { display: block; width: 100%; height: 100%; border: 0; } #film-b { box-sizing: border-box; display: grid; place-items: center; padding: calc(max(16px, env(safe-area-inset-top)) + 64px) max(16px, 4vw) calc(max(16px, env(safe-area-inset-bottom)) + 28px); }
