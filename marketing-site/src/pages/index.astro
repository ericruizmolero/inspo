/* ventana retro que se maximiza al llegar al negro */
/* la página es clara salvo mientras criterio.md llena la pantalla y desde que el cierre llega a media pantalla (html.dark, lo pone win()); todo lo de debajo cambia a la vez. El oscuro es UNA capa fija (body::before) que entra y sale por opacidad, sin repintar: con un color animado, al hacer scroll rápido Chrome no repinta todas las teselas a tiempo y se ve un corte entre secciones. Las secciones son transparentes, también la ventana de criterio.md (.mf-w, solo un borde): no hay tarjeta oscura sobre página clara; todo está en claro o todo en oscuro */
html { background: #E7E5DF; } body { background: transparent; } html, body { transition: color var(--ti); } html.dark, html.dark body { color: #F1EEE5; } body::before { content: ""; position: fixed; inset: -50vh 0; z-index: -1; background: #0D0D0B; opacity: 0; pointer-events: none; transition: opacity var(--ts); will-change: opacity; } html.dark body::before { opacity: 1; }
/* al cargar la página ya a media altura, el tema entra sin fundido */
html.th0, html.th0 * { transition: none !important; }
/* tokens de tema de criterio.md y el cierre: oscuros por defecto (la ventana encogida es oscura sobre la página clara); claros cuando la página es clara y criterio.md ya llena la pantalla, y en el cierre. Registrados con @property para que el color se funda a la vez en todo */
@property --ink { syntax: '<color>'; inherits: true; initial-value: #1B1B18; } @property --paper-l { syntax: '<color>'; inherits: true; initial-value: #F6F1E6; } @property --text-2 { syntax: '<color>'; inherits: true; initial-value: #5A5850; } @property --t-bg { syntax: '<color>'; inherits: true; initial-value: #0D0D0B; } @property --t-fg { syntax: '<color>'; inherits: true; initial-value: #F1EEE5; } @property --t-hi { syntax: '<color>'; inherits: true; initial-value: #FFFFFF; } @property --t-b { syntax: '<color>'; inherits: true; initial-value: #C8C5BA; } @property --t-p { syntax: '<color>'; inherits: true; initial-value: #B8B1A3; } @property --t-2 { syntax: '<color>'; inherits: true; initial-value: #9B988D; } @property --t-3 { syntax: '<color>'; inherits: true; initial-value: #8D8A80; } @property --t-4 { syntax: '<color>'; inherits: true; initial-value: #8F8B80; } @property --t-tab { syntax: '<color>'; inherits: true; initial-value: #F1EEE5; } @property --t-foot { syntax: '<color>'; inherits: true; initial-value: #151411; } @property --t-line { syntax: '<color>'; inherits: true; initial-value: #2B2924; } @property --t-note { syntax: '<color>'; inherits: true; initial-value: #E8E0CF; } 
.mf a, .end a { transition: none; }
.mf, .end { transition: --t-bg var(--ts), --t-fg var(--ti), --t-hi var(--ti), --t-b var(--ti), --t-p var(--ti), --t-2 var(--ti), --t-3 var(--ti), --t-4 var(--ti), --t-tab var(--ts), --t-foot var(--ts), --t-line var(--ti), --t-note var(--ti); }
html:not(.dark) .mf, html:not(.dark) .end { --t-bg: #E7E5DF; --t-fg: #1B1B18; --t-hi: #1B1B18; --t-b: #3A3832; --t-p: #5A5850; --t-2: #5A5850; --t-3: #6E6A60; --t-4: #6A665C; --t-tab: #D3CFC5; --t-foot: #EFEBE2; --t-line: #D3CFC5; --t-note: #3A3832; }
