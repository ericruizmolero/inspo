---
import { PAGES, type Locale, type PageKey } from "../i18n";

interface Props {
  title: string;
  description: string;
  lang?: Locale;
  /** Leave out on pages with no address of their own (404): no canonical, no alternates */
  page?: PageKey;
}
const { title, description, lang = "en", page } = Astro.props;
const at = (path: string) => new URL(path, Astro.site).href;
const canonical = page ? at(PAGES[page][lang]) : undefined;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {page && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/icon-512.png" />
    {page && <link rel="alternate" hreflang="en" href={at(PAGES[page].en)} />}
    {page && <link rel="alternate" hreflang="es" href={at(PAGES[page].es)} />}
    {page && <link rel="alternate" hreflang="x-default" href={at(PAGES[page].en)} />}
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {page && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content="website" />
    <link rel="preload" href="/fonts/Satoshi-Variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* Same tokens as the app (docs/design-system/fundamentos/color.md), Paper theme only */
  @font-face {
    font-family: "Satoshi";
    src: url("/fonts/Satoshi-Variable.woff2") format("woff2");
    font-weight: 300 900;
    font-display: swap;
  }
  :root {
    --paper: #ede6d6;
    --paper-white: #fcfaf6;
    --paper-light: #f6f1e6;
    --paper-pressed: #d9cfba;
    --ink: #1b1b18;
    --ember: #e8892b;
    --ember-glow: #f6a848;
    --text-2: #5a5850;
    --border: #d9d1bf;
    --font-sans: "Satoshi", ui-sans-serif, system-ui, sans-serif;
    --bevel: inset 2px 2px 0 rgba(255, 255, 255, 0.65), inset -2px -3px 0 rgba(27, 27, 24, 0.22);
    --bevel-pressed: inset 2px 3px 0 rgba(27, 27, 24, 0.22);
    color-scheme: light;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--paper-white);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }
  /* The footer sits at the bottom of a short page */
  body > * { width: 100%; }
  body > main { flex: 1 0 auto; }
  h1, h2, p { margin: 0; }
</style>
