---
import CookieNotice from "../components/CookieNotice.astro";
import { PAGES, type Locale, type PageKey } from "../i18n";

interface Props {
  title: string;
  description: string;
  lang?: Locale;
  /** Leave out on pages with no address of their own (404): no canonical, no alternates */
  page?: PageKey;
}
const { title, description, lang = "en", page } = Astro.props;
const at = (path: string) => new URL(path, Astro.site).href;
const canonical = page ? at(PAGES[page].path[lang]) : undefined;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {page && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-512.png" />
    {page && <link rel="alternate" hreflang="en" href={at(PAGES[page].path.en)} />}
    {page && <link rel="alternate" hreflang="es" href={at(PAGES[page].path.es)} />}
    {page && <link rel="alternate" hreflang="x-default" href={at(PAGES[page].path.en)} />}
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {page && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Criterio" />
    <meta property="og:image" content={at(`/og-home-${lang}.jpg?v=20261125`)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#E7E5DF" />
    <link rel="preload" href="/assets/fonts/geist-serif/GeistSerifVF.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/satoshi/Satoshi-Variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
    <CookieNotice locale={lang} />
  </body>
</html>

<style is:global>
  /* Same colour tokens as the app (docs/design-system/fundamentos/color.md), Paper theme only.
     Type is the home's (pages/index.astro): headings in the display serif, regular and tight; text in Satoshi */
  @font-face { font-family: "Geist Serif"; src: url("/assets/fonts/geist-serif/GeistSerifVF.woff2") format("woff2"); font-weight: 100 900; font-display: swap; }
  @font-face { font-family: "Satoshi"; src: url("/assets/fonts/satoshi/Satoshi-Variable.woff2") format("woff2"); font-weight: 300 900; font-display: swap; }
  :root {
    --paper: #ede6d6;
    --paper-white: #fcfaf6;
    --paper-light: #f6f1e6;
    --paper-pressed: #d9cfba;
    --ink: #1b1b18;
    --ember: #e8892b;
    --ember-glow: #f6a848;
    --text-2: #5a5850;
    --border: #cfcabe;
    --font-sans: "Satoshi", ui-sans-serif, system-ui, sans-serif;
    --font-display: "Geist Serif", Georgia, serif;
    /* A heading in the display serif: its weight and tracking, as on the home */
    --h-w: 400;
    --h-ls: -0.015em;
    --h-2: #7f7b71;
    /* The home's names for the same things: the header is the same one (SiteHeader.astro) */
    --page: #e7e5df;
    --sans: var(--font-sans);
    --display: var(--font-display);
    --r: 14px;
    --rb: 9px;
    --bevel-in: var(--bevel-pressed);
    --out: cubic-bezier(0.16, 1, 0.3, 1);
    --bevel: inset 2px 2px 0 rgba(255, 255, 255, 0.65), inset -2px -3px 0 rgba(27, 27, 24, 0.22);
    --bevel-pressed: inset 2px 3px 0 rgba(27, 27, 24, 0.22);
    color-scheme: light;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    /* the header lies over the top of the page */
    padding-top: clamp(72px, 10svh, 112px);
    background: var(--page);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }
  /* The footer sits at the bottom of a short page */
  body > * { width: 100%; }
  body > main { flex: 1 0 auto; }
  :focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; border-radius: 4px; }
  h1, h2, p { margin: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* The search and the menu over a list (resources, skills), stuck to the top while the list scrolls. Shown by
     the page's script: without it the whole list is there to read */
  .tools { position: sticky; top: 0; z-index: 1; display: flex; flex-wrap: wrap; gap: 8px; margin: -16px -8px -8px; padding: 12px 8px; background: var(--page); }
  .tools[hidden] { display: none; }
  .tools > input { flex: 1 1 240px; min-width: 0; }
  .tools > select { flex: 0 1 auto; max-width: 100%; cursor: pointer; }
  .field {
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--paper-light);
    color: var(--ink);
    font: inherit;
  }
  .field::placeholder { color: var(--text-2); }
  .field:focus-visible { outline: 2px solid var(--ink); outline-offset: 1px; }
  .badge { padding: 1px 8px; border: 1px solid var(--ink); border-radius: 999px; background: var(--paper-white); font-size: 12px; font-weight: 600; white-space: nowrap; }
</style>
