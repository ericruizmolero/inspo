{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "git": { "deploymentEnabled": { "**": false, "main": true } },
  "buildCommand": "npm run db:migrate && npm run build",
  "functions": {
    "app/api/queue/jobs/route.ts": {
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "jobs", "retryAfterSeconds": 60 }]
    }
  },
  "crons": [
    { "path": "/api/cron/usage-check", "schedule": "0 23 * * *" },
    { "path": "/api/cron/morning", "schedule": "0 4 * * *" }
  ]
}
